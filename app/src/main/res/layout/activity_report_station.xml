<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report Water Station &amp; Rate"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Station Name / ID (e.g., FSKTM Level 2 Cooler)"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Issue Category"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerIssue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAttachPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Attach Photo Evidence"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/ivPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="#EEEEEE"
            android:contentDescription="Attached station photo preview"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvGpsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS: Fetching..."
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTimestampInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timestamp: --"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnRefreshLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Refresh GPS &amp; Timestamp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cleanliness &amp; Water Taste Rating"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RatingBar
            android:id="@+id/ratingBarCleanliness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:rating="4.0"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etReviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Write a review on cleanliness, taste, or issue details"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="5"
            android:scrollbars="vertical"
            android:gravity="top|start"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Submit Report &amp; Rating"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOpenNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="View Notification History" />

    </LinearLayout>
</ScrollView>